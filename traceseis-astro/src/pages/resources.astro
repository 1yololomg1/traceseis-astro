---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Resources — TraceSeis"
  description="Selected publications and resources from TraceSeis."
>

  <section class="page-header">
    <div class="container">
      <p class="label-sm" style="color: var(--color-accent); margin-bottom: 8px;">Resources</p>
      <h1>Publications &amp; Resources</h1>
      <p class="lead">Selected publications featuring TraceSeis research and methodology.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="highlight-row">
        <div>
          <div class="card card-accent" style="margin-bottom: 24px;">
            <p style="color: var(--color-text-tertiary); font-size: 14px; margin-bottom: 8px;">AAPG Explorer &middot; 2018</p>
            <h3>Relative Rock Properties</h3>
            <p>Published in the AAPG Explorer, this article discusses TraceSeis's approach to relative rock properties and its applications in reservoir characterization.</p>
            <a href="https://www.aapg.org/news-and-media/details/explorer/articleid/44498/relative-rock-properties" target="_blank" rel="noopener" class="card-link">Read the article</a>
          </div>
          <div class="card card-accent">
            <p style="color: var(--color-text-tertiary); font-size: 14px; margin-bottom: 8px;">Google Scholar</p>
            <h3>Research Publications</h3>
            <p>Alvaro Chaveste, Founder and CEO of TraceSeis, has published research in rock physics, reservoir characterization, seismic inversion, and AVAZ analysis.</p>
            <a href="https://scholar.google.com/citations?user=rjBRzCEAAAAJ&hl=en" target="_blank" rel="noopener" class="card-link">View on Google Scholar</a>
          </div>
        </div>
        <div class="art-frame">
          <img src="/images/terraces-circular.jpg" alt="Geological formation visualization" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
