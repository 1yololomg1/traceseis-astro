---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="TraceSeis — Quantitative reservoir characterization, made practical" description="TraceSeis delivers practical, physics‑grounded workflows that connect rock, reservoir and seismic to reduce subsurface uncertainty.">
  <section class="hero wrap" id="home">
    <h1>Quantitative reservoir characterization, made practical</h1>
    <p class="sub">TraceSeis delivers physics‑grounded workflows that connect rock, reservoir and seismic to reduce uncertainty and improve decisions.</p>
    <div class="cta">
      <a class="btn primary" href="/services">See our services</a>
      <a class="btn" href="/software">Explore software</a>
      <a class="btn" href="/contact">Talk to an expert</a>
    </div>
  </section>

  <section class="section wrap">
    <h2>What we do</h2>
    <div class="grid">
      <article class="card">
        <h3>Services</h3>
        <p>From seismic processing to inversion to reservoir properties, delivered as projects or embedded support.</p>
        <p><a href="/services">Explore services</a></p>
      </article>
      <article class="card">
        <h3>Software</h3>
        <p>Tools for rock physics and interpretation, including SeisTool for rock and reservoir property analysis.</p>
        <p><a href="/software">View software</a></p>
      </article>
      <article class="card">
        <h3>Partners</h3>
        <p>We work with leaders in seismic imaging, analytics, and petrophysics to extend capability.</p>
        <p><a href="/partners">See partners</a></p>
      </article>
      <article class="card">
        <h3>Resources</h3>
        <p>Selected publications including AAPG Explorer: Relative Rock Properties.</p>
        <p><a href="/resources">Read publications</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
