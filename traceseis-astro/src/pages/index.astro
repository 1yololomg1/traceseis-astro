---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="TraceSeis — Geoscience Solutions Through Services, Consulting and Software"
  description="Founded in 2003 in Houston, TraceSeis specializes in quantitative reservoir characterization for the oil and gas industry."
>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-bg-art" aria-hidden="true">
      <img src="/images/landscape-geological.jpg" alt="" />
    </div>
    <div class="container hero-content">
      <span class="hero-badge">Quantitative Reservoir Characterization</span>
      <h1>Geoscience Solutions Through Services, Consulting and Software</h1>
      <p class="hero-desc">
        Since 2003, TraceSeis has delivered specialized expertise in characterizing
        relationships between rock properties, reservoir attributes, and seismic data.
      </p>
      <div class="hero-actions">
        <a href="/services" class="btn btn-primary">Our Services</a>
        <a href="/contact" class="btn btn-outline-light">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="label-sm" style="color: var(--color-accent); margin-bottom: 8px;">What We Do</p>
        <h2>Integrated Geoscience Services</h2>
        <p class="lead">Specialized services designed to reduce risk when quantifying reservoir properties using well-calibrated seismic analysis.</p>
      </div>
      <div class="grid-4">
        <div class="card card-accent">
          <h3>Seismic Data Processing</h3>
          <p>Advanced techniques to enhance data quality and resolution with customized workflows tailored to specific geological challenges.</p>
          <a href="/services" class="card-link">Learn more</a>
        </div>
        <div class="card card-accent">
          <h3>Feasibility Studies</h3>
          <p>Thorough assessments evaluating data quality, geological complexity, and technical viability to guide decision-making.</p>
          <a href="/services" class="card-link">Learn more</a>
        </div>
        <div class="card card-accent">
          <h3>Lithofacies Prediction</h3>
          <p>Accurate predictions using integrated seismic and well-log data combined with rock physics modeling.</p>
          <a href="/services" class="card-link">Learn more</a>
        </div>
        <div class="card card-accent">
          <h3>Inversion to Reservoir Properties</h3>
          <p>Proprietary methodologies that transform seismic attributes into porosity, saturation, and other reservoir parameters.</p>
          <a href="/services" class="card-link">Learn more</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section-alt">
    <div class="container">
      <div class="highlight-row">
        <div class="highlight-text">
          <p class="label-sm" style="color: var(--color-accent); margin-bottom: 8px;">Our Approach</p>
          <h2>Reducing Dependency on Low Frequency Models</h2>
          <p>TraceSeis has developed a methodology for advanced reservoir property estimation that reduces reliance on traditional Low Frequency Models, providing a more streamlined workflow for reservoir characterization.</p>
          <p>By leveraging relative rock properties, the approach computes reservoir properties directly from seismic data, reducing required user inputs and simplifying complex workflows.</p>
          <a href="/services" class="btn btn-secondary mt-16">Explore Services</a>
        </div>
        <div class="art-frame">
          <img src="/images/vortex-grayscale.jpg" alt="Seismic data visualization" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Art Showcase -->
  <section class="section">
    <div class="container">
      <div class="art-grid">
        <div class="art-cell span-2">
          <img src="/images/landscape-geological.jpg" alt="Geological landscape visualization" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/strata-ink.jpg" alt="Geological strata study" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/seismic-waveforms.jpg" alt="Seismic waveform patterns" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/terraces-blue.jpg" alt="Subsurface terrain visualization" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/terraces-circular.jpg" alt="Concentric geological formation" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/vortex-pastel.jpg" alt="Seismic wave propagation" loading="lazy" />
        </div>
        <div class="art-cell">
          <img src="/images/textile-pattern.jpg" alt="Geological pattern study" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Facts -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stats-row">
        <div class="stat-item">
          <div class="stat-value">2003</div>
          <div class="stat-label">Founded in Houston, Texas</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">3</div>
          <div class="stat-label">Integrated offerings: Services, Consulting, Software</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">4</div>
          <div class="stat-label">Industry partners</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to discuss your project?</h2>
      <p>Contact our team to learn how TraceSeis can support your reservoir characterization objectives.</p>
      <a href="/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </section>

</BaseLayout>
