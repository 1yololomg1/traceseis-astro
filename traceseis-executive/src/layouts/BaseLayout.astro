---
/**
 * BaseLayout.astro
 * 
 * Primary layout component for all pages. Provides:
 * - SEO meta tags and Open Graph support
 * - Professional navigation header with mobile responsiveness
 * - Consistent footer with company information
 * - Global styles and scripts
 */

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description = 'TraceSeis delivers quantitative reservoir characterization through advanced geoscience solutions, proprietary software, and expert consulting services.',
  ogImage = '/og-default.jpg',
  canonicalUrl
} = Astro.props;

const currentPath = Astro.url.pathname;

// Navigation items - structured for executive audience
const navItems = [
  { label: 'Services', href: '/services' },
  { label: 'CONFIRM', href: '/confirm' },
  { label: 'Software', href: '/software' },
  { label: 'About', href: '/about' },
  { label: 'Resources', href: '/resources' },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect to font provider -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Schema.org structured data for organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "TraceSeis",
        "description": "Quantitative reservoir characterization through advanced geoscience solutions",
        "url": "https://www.traceseis.com",
        "foundingDate": "2003",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Houston",
          "addressRegion": "TX",
          "addressCountry": "US"
        },
        "sameAs": [
          "https://www.linkedin.com/company/traceseis-inc"
        ]
      }
    </script>
  </head>
  
  <body class="bg-navy-950 text-white font-sans">
    <!-- Header / Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="main-header">
      <div class="absolute inset-0 bg-navy-950/80 backdrop-blur-xl border-b border-navy-800/50"></div>
      <nav class="container-wide relative">
        <div class="flex items-center justify-between h-16 lg:h-20">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-accent-500 to-primary-600 flex items-center justify-center">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12h4l3-9 4 18 3-9h4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span class="text-xl font-bold text-white group-hover:text-accent-400 transition-colors">TraceSeis</span>
          </a>
          
          <!-- Desktop Navigation -->
          <div class="hidden lg:flex items-center gap-1">
            {navItems.map((item) => (
              <a 
                href={item.href} 
                class:list={[
                  'px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                  currentPath === item.href || currentPath.startsWith(item.href + '/')
                    ? 'text-white bg-white/10'
                    : 'text-navy-300 hover:text-white hover:bg-white/5'
                ]}
              >
                {item.label}
              </a>
            ))}
          </div>
          
          <!-- CTA Button -->
          <div class="hidden lg:flex items-center gap-4">
            <a href="/contact" class="btn-primary">
              Contact Us
              <svg class="w-4 h-4 ml-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
          
          <!-- Mobile Menu Button -->
          <button 
            type="button" 
            class="lg:hidden p-2 rounded-lg text-navy-300 hover:text-white hover:bg-white/10 transition-colors"
            id="mobile-menu-btn"
            aria-label="Toggle navigation menu"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
        
        <!-- Mobile Navigation -->
        <div class="lg:hidden hidden" id="mobile-menu">
          <div class="py-4 space-y-1 border-t border-navy-800/50">
            {navItems.map((item) => (
              <a 
                href={item.href} 
                class:list={[
                  'block px-4 py-3 rounded-lg text-base font-medium transition-colors',
                  currentPath === item.href 
                    ? 'text-white bg-white/10' 
                    : 'text-navy-300 hover:text-white hover:bg-white/5'
                ]}
              >
                {item.label}
              </a>
            ))}
            <a href="/contact" class="block px-4 py-3 text-accent-400 font-semibold">
              Contact Us
            </a>
          </div>
        </div>
      </nav>
    </header>
    
    <!-- Main Content -->
    <main class="pt-16 lg:pt-20">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-navy-950 border-t border-navy-800/50">
      <div class="container-wide py-16 lg:py-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
          <!-- Company Info -->
          <div class="lg:col-span-1">
            <a href="/" class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-accent-500 to-primary-600 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 12h4l3-9 4 18 3-9h4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="text-xl font-bold text-white">TraceSeis</span>
            </a>
            <p class="text-navy-400 text-sm leading-relaxed mb-6">
              Delivering quantitative reservoir characterization through advanced geoscience solutions since 2003.
            </p>
            <div class="flex items-center gap-4">
              <a 
                href="https://www.linkedin.com/company/traceseis-inc" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-navy-400 hover:text-accent-400 transition-colors"
                aria-label="LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
          
          <!-- Services -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Services</h4>
            <ul class="space-y-3">
              <li><a href="/services#seismic-processing" class="text-navy-400 hover:text-white text-sm transition-colors">Seismic Data Processing</a></li>
              <li><a href="/services#feasibility" class="text-navy-400 hover:text-white text-sm transition-colors">Feasibility Studies</a></li>
              <li><a href="/services#lithofacies" class="text-navy-400 hover:text-white text-sm transition-colors">Lithofacies Prediction</a></li>
              <li><a href="/services#inversion" class="text-navy-400 hover:text-white text-sm transition-colors">Reservoir Inversion</a></li>
            </ul>
          </div>
          
          <!-- Solutions -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Solutions</h4>
            <ul class="space-y-3">
              <li><a href="/confirm" class="text-navy-400 hover:text-white text-sm transition-colors">CONFIRM Technology</a></li>
              <li><a href="/software" class="text-navy-400 hover:text-white text-sm transition-colors">SeisTool Software</a></li>
              <li><a href="/resources" class="text-navy-400 hover:text-white text-sm transition-colors">Publications</a></li>
              <li><a href="/partners" class="text-navy-400 hover:text-white text-sm transition-colors">Partners</a></li>
            </ul>
          </div>
          
          <!-- Contact -->
          <div>
            <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Contact</h4>
            <ul class="space-y-3 text-sm text-navy-400">
              <li>Houston, Texas</li>
              <li>
                <a href="tel:+18327076505" class="hover:text-white transition-colors">+1 (832) 707-6505</a>
              </li>
              <li>
                <a href="mailto:info@traceseis.com" class="hover:text-white transition-colors">info@traceseis.com</a>
              </li>
            </ul>
            <a href="/contact" class="inline-flex items-center mt-4 text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
              Get in touch
              <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Bottom Bar -->
        <div class="mt-12 pt-8 border-t border-navy-800/50">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-navy-500 text-sm">
              &copy; {new Date().getFullYear()} TraceSeis Inc. All rights reserved.
            </p>
            <div class="flex items-center gap-6 text-sm">
              <a href="/privacy" class="text-navy-500 hover:text-navy-300 transition-colors">Privacy Policy</a>
              <a href="/terms" class="text-navy-500 hover:text-navy-300 transition-colors">Terms of Service</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
    
    <!-- Mobile Menu Script -->
    <script>
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });
      
      // Header scroll effect
      const header = document.getElementById('main-header');
      let lastScroll = 0;
      
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        
        if (currentScroll > 100) {
          header?.classList.add('shadow-lg', 'shadow-navy-950/50');
        } else {
          header?.classList.remove('shadow-lg', 'shadow-navy-950/50');
        }
        
        lastScroll = currentScroll;
      });
    </script>
    
    <!-- Global styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
  </body>
</html>
