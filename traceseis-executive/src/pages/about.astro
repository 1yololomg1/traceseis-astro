---
/**
 * About Page - about.astro
 * 
 * Company background, team, and values for TraceSeis.
 * Emphasizes technical credibility and experience to build trust
 * with executive decision makers.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About TraceSeis - Quantitative Reservoir Characterization Experts"
  description="Founded in 2003 in Houston, TraceSeis delivers quantitative reservoir characterization through advanced geoscience solutions, consulting, and proprietary software."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <h1 class="heading-xl mb-6">
          Two Decades of
          <span class="text-gradient"> Quantitative Excellence</span>
        </h1>
        <p class="text-xl text-navy-300 leading-relaxed">
          Since 2003, TraceSeis has been helping exploration and production teams make better decisions through rigorous, science-based reservoir characterization.
        </p>
      </div>
    </div>
  </section>

  <!-- Company Story -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="heading-lg mb-6">Our Story</h2>
          <p class="body-lg mb-6">
            TraceSeis was founded in Houston in 2003 with a clear mission: bring quantitative rigor to seismic interpretation by applying established rock physics principles and advanced computational methods.
          </p>
          <p class="body-md mb-6">
            From the beginning, we recognized that the value of seismic data lies not in pretty pictures, but in its ability to quantitatively constrain reservoir properties. This philosophy drives everything we do - from our consulting projects to our software development.
          </p>
          <p class="body-md">
            Today, TraceSeis serves exploration and production companies worldwide, providing the technical expertise and tools needed to reduce uncertainty and improve drilling success rates.
          </p>
        </div>
        
        <div class="space-y-6">
          <div class="card p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-accent-500/20 flex items-center justify-center">
                <span class="text-accent-400 font-bold text-lg">20+</span>
              </div>
              <div>
                <div class="font-semibold text-white">Years of Experience</div>
                <div class="text-navy-400 text-sm">Delivering quantitative solutions since 2003</div>
              </div>
            </div>
          </div>
          
          <div class="card p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-accent-500/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-white">Global Reach</div>
                <div class="text-navy-400 text-sm">Projects across diverse geological settings worldwide</div>
              </div>
            </div>
          </div>
          
          <div class="card p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-accent-500/20 flex items-center justify-center">
                <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-white">Science-First Approach</div>
                <div class="text-navy-400 text-sm">Every analysis grounded in established physics</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="heading-lg mb-6">Leadership</h2>
        <p class="body-lg">
          TraceSeis is led by experienced geoscientists with deep expertise in quantitative interpretation and rock physics.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Alvaro Chaveste -->
        <div class="card p-8">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 mx-auto">
            <svg class="w-10 h-10 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <div class="text-center">
            <h3 class="heading-sm mb-1">Alvaro Chaveste</h3>
            <p class="text-accent-400 font-medium mb-4">Founder & CEO</p>
            <p class="text-navy-400 text-sm mb-6">
              With decades of experience in quantitative seismic interpretation and rock physics, Alvaro founded TraceSeis to bring rigorous scientific methods to reservoir characterization. His expertise spans seismic inversion, AVO analysis, and lithofacies prediction across diverse geological settings.
            </p>
            <div class="flex justify-center gap-4">
              <a href="mailto:achaveste@traceseis.com" class="text-navy-400 hover:text-accent-400 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
              <a href="https://www.linkedin.com/company/traceseis-inc" target="_blank" rel="noopener" class="text-navy-400 hover:text-accent-400 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
        
        <!-- Alvaro Chaveste II -->
        <div class="card p-8">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 mx-auto">
            <svg class="w-10 h-10 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <div class="text-center">
            <h3 class="heading-sm mb-1">Alvaro Chaveste II</h3>
            <p class="text-accent-400 font-medium mb-4">Business Development Lead</p>
            <p class="text-navy-400 text-sm mb-6">
              Alvaro II leads TraceSeis business development efforts, working with clients to understand their challenges and match them with the right solutions. His focus is on building long-term partnerships that deliver measurable value.
            </p>
            <div class="flex justify-center gap-4">
              <a href="mailto:alvarochf@traceseis.com" class="text-navy-400 hover:text-accent-400 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
              <a href="https://www.linkedin.com/company/traceseis-inc" target="_blank" rel="noopener" class="text-navy-400 hover:text-accent-400 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="heading-lg mb-6">Our Approach</h2>
        <p class="body-lg">
          We believe that good geoscience decisions require more than intuition - they require quantitative analysis grounded in physics.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card p-6 text-center">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Scientific Rigor</h3>
          <p class="text-navy-400 text-sm">
            Every analysis built on established physics and validated methodologies.
          </p>
        </div>
        
        <div class="card p-6 text-center">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Transparency</h3>
          <p class="text-navy-400 text-sm">
            Methods and assumptions fully documented and auditable.
          </p>
        </div>
        
        <div class="card p-6 text-center">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Uncertainty Quantification</h3>
          <p class="text-navy-400 text-sm">
            Results delivered with confidence intervals, not just point estimates.
          </p>
        </div>
        
        <div class="card p-6 text-center">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Partnership</h3>
          <p class="text-navy-400 text-sm">
            Working alongside your team to transfer knowledge and capability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="heading-lg mb-6">Houston, Texas</h2>
          <p class="body-lg mb-6">
            TraceSeis is headquartered in Houston, the global center of the energy industry. Our location provides direct access to operators, service companies, and research institutions that drive innovation in subsurface characterization.
          </p>
          <p class="body-md">
            While based in Houston, we serve clients worldwide, with project experience spanning North America, South America, West Africa, the Middle East, and Asia Pacific.
          </p>
        </div>
        
        <div class="card p-8">
          <div class="aspect-video rounded-lg bg-navy-900/50 border border-navy-700/50 flex items-center justify-center mb-6">
            <div class="text-center">
              <svg class="w-16 h-16 text-navy-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <p class="text-navy-500 text-sm">Houston, TX</p>
            </div>
          </div>
          <div class="text-center">
            <p class="text-white font-medium mb-2">TraceSeis Inc.</p>
            <p class="text-navy-400 text-sm">Houston, Texas, USA</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-950 via-navy-950 to-primary-950"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-lg mb-6">Ready to Work Together?</h2>
        <p class="body-lg mb-10">
          Contact us to discuss how TraceSeis can help you make better reservoir decisions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary text-base px-8 py-4">
            Get in Touch
            <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="/services" class="btn-secondary text-base px-8 py-4">
            View Services
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
