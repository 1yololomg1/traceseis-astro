---
/**
 * Software Page - software.astro
 * 
 * Showcases TraceSeis software products with download functionality:
 * - SeisTool: Rock physics analysis software
 * - Future products as needed
 * 
 * Downloads are served from the /public/downloads/ directory
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Software - Rock Physics Analysis Tools | TraceSeis"
  description="Download SeisTool and other TraceSeis software for rock physics analysis, fluid substitution modeling, and AVO response prediction."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm text-navy-300 mb-6">
          Purpose-Built Tools
        </div>
        <h1 class="heading-xl mb-6">
          Rock Physics
          <span class="text-gradient"> Software</span>
        </h1>
        <p class="text-xl text-navy-300 leading-relaxed">
          Specialized software tools developed from decades of quantitative interpretation experience. Designed for geoscientists who need reliable, scientifically-grounded analysis capabilities.
        </p>
      </div>
    </div>
  </section>

  <!-- SeisTool Section -->
  <section class="section section-gradient" id="seistool">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/10 text-xs font-medium text-accent-400 uppercase tracking-wider mb-4">
            Featured Software
          </div>
          <h2 class="heading-lg mb-2">SeisTool</h2>
          <p class="text-lg text-navy-400 mb-6">Rock Physics Analysis Software</p>
          
          <p class="body-lg mb-6">
            SeisTool provides a comprehensive environment for rock physics analysis, enabling geoscientists to understand and predict seismic response to changes in rock and fluid properties.
          </p>
          
          <p class="body-md mb-8">
            Built on established rock physics theory, SeisTool implements the same algorithms used in our consulting projects, giving you direct access to the tools that power TraceSeis analyses.
          </p>
          
          <!-- Key Features -->
          <h3 class="font-semibold text-white mb-4">Core Capabilities</h3>
          <div class="space-y-3 mb-8">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-navy-300"><strong class="text-white">Fluid Substitution:</strong> Gassmann-based modeling for predicting seismic response to fluid changes</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-navy-300"><strong class="text-white">AVO Modeling:</strong> Synthetic gather generation using Zoeppritz equations and approximations</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-navy-300"><strong class="text-white">Crossplot Analysis:</strong> Interactive visualization of elastic property relationships</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-navy-300"><strong class="text-white">Log Analysis:</strong> Well log display, editing, and rock physics computation</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-navy-300"><strong class="text-white">Rock Physics Templates:</strong> Build and apply RPTs for lithology/fluid discrimination</span>
            </div>
          </div>
          
          <!-- Download Section -->
          <div class="card p-6 border-accent-500/30" id="download">
            <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Download SeisTool
            </h3>
            
            <div class="space-y-4">
              <!-- Windows Download -->
              <div class="flex items-center justify-between p-4 rounded-xl bg-navy-900/50 border border-navy-700/50">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-lg bg-navy-800 flex items-center justify-center">
                    <svg class="w-5 h-5 text-navy-300" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-medium text-white">Windows</div>
                    <div class="text-xs text-navy-400">Windows 10/11 (64-bit)</div>
                  </div>
                </div>
                <a 
                  href="/downloads/seistool-windows.zip" 
                  class="btn-primary text-sm px-4 py-2"
                  download
                >
                  <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Download
                </a>
              </div>
              
              <!-- Version Info -->
              <div class="flex items-center justify-between text-sm">
                <span class="text-navy-400">Current Version: <span class="text-white">2.5.1</span></span>
                <a href="#release-notes" class="text-accent-400 hover:text-accent-300 transition-colors">Release Notes</a>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Column - Technical Details -->
        <div class="space-y-6">
          <!-- Screenshot placeholder -->
          <div class="card p-8 bg-gradient-to-br from-navy-800/50 to-navy-900/50">
            <div class="aspect-video rounded-lg bg-navy-900/50 border border-navy-700/50 flex items-center justify-center">
              <div class="text-center">
                <svg class="w-16 h-16 text-navy-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <p class="text-navy-500 text-sm">SeisTool Interface</p>
              </div>
            </div>
          </div>
          
          <!-- System Requirements -->
          <div class="card p-6">
            <h3 class="font-semibold text-white mb-4">System Requirements</h3>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-navy-400">Operating System</span>
                <span class="text-white">Windows 10/11 (64-bit)</span>
              </div>
              <div class="divider"></div>
              <div class="flex justify-between">
                <span class="text-navy-400">Processor</span>
                <span class="text-white">Intel i5 or equivalent</span>
              </div>
              <div class="divider"></div>
              <div class="flex justify-between">
                <span class="text-navy-400">Memory</span>
                <span class="text-white">8 GB RAM minimum</span>
              </div>
              <div class="divider"></div>
              <div class="flex justify-between">
                <span class="text-navy-400">Disk Space</span>
                <span class="text-white">500 MB available</span>
              </div>
              <div class="divider"></div>
              <div class="flex justify-between">
                <span class="text-navy-400">Display</span>
                <span class="text-white">1920x1080 recommended</span>
              </div>
            </div>
          </div>
          
          <!-- Theoretical Basis -->
          <div class="card p-6">
            <h3 class="font-semibold text-white mb-4">Theoretical Foundation</h3>
            <p class="text-navy-400 text-sm mb-4">
              SeisTool implements established rock physics models:
            </p>
            <ul class="space-y-2 text-sm text-navy-300">
              <li class="flex items-start gap-2">
                <span class="text-accent-400">-</span>
                <span><strong class="text-white">Gassmann (1951):</strong> Low-frequency fluid substitution</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">-</span>
                <span><strong class="text-white">Batzle-Wang (1992):</strong> Fluid property estimation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">-</span>
                <span><strong class="text-white">Zoeppritz (1919):</strong> Reflection coefficient computation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">-</span>
                <span><strong class="text-white">Aki-Richards:</strong> Linearized AVO approximation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">-</span>
                <span><strong class="text-white">Shuey (1985):</strong> Two/three-term AVO</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Release Notes -->
  <section class="section section-dark" id="release-notes">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto">
        <h2 class="heading-md mb-8">Release Notes</h2>
        
        <div class="space-y-6">
          <!-- Latest Release -->
          <div class="card p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-white">Version 2.5.1</h3>
              <span class="px-3 py-1 text-xs font-medium bg-accent-500/20 text-accent-400 rounded-full">Latest</span>
            </div>
            <p class="text-navy-400 text-sm mb-4">Released December 2024</p>
            <ul class="space-y-2 text-sm text-navy-300">
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Improved Gassmann fluid substitution workflow with enhanced mineral modulus database</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Added support for LAS 3.0 file format import</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Enhanced crossplot functionality with user-defined color coding</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">~</span>
                <span>Performance improvements for large well datasets</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-400">~</span>
                <span>Updated documentation and help system</span>
              </li>
            </ul>
          </div>
          
          <!-- Previous Release -->
          <div class="card p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-white">Version 2.5.0</h3>
            </div>
            <p class="text-navy-400 text-sm mb-4">Released September 2024</p>
            <ul class="space-y-2 text-sm text-navy-300">
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>New AVO synthetic modeling module with angle-dependent wavelet support</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Extended elastic impedance calculation tools</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Rock physics template (RPT) builder and library</span>
              </li>
            </ul>
          </div>
          
          <!-- Older Release -->
          <div class="card p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold text-white">Version 2.4.x</h3>
            </div>
            <p class="text-navy-400 text-sm mb-4">2023 Releases</p>
            <ul class="space-y-2 text-sm text-navy-300">
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Batch processing capabilities for multi-well analysis</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Export to standard industry formats (ASCII, CSV)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-success-500">+</span>
                <span>Enhanced visualization and plotting options</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Section -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card card-hover p-6 text-center">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Documentation</h3>
          <p class="text-navy-400 text-sm mb-4">
            Comprehensive user guides and theoretical background included with download.
          </p>
        </div>
        
        <div class="card card-hover p-6 text-center">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Technical Support</h3>
          <p class="text-navy-400 text-sm mb-4">
            Email support available for licensed users with questions or issues.
          </p>
        </div>
        
        <div class="card card-hover p-6 text-center">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Training</h3>
          <p class="text-navy-400 text-sm mb-4">
            On-site or remote training sessions available for teams.
          </p>
          <a href="/contact" class="text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Inquire about training
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-lg mb-6">Questions About Our Software?</h2>
        <p class="body-lg mb-10">
          Contact us to discuss licensing options, custom development, or technical questions about SeisTool capabilities.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary text-base px-8 py-4">
            Contact Us
            <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="#download" class="btn-secondary text-base px-8 py-4">
            Download Now
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
