---
/**
 * Contact Page - contact.astro
 * 
 * Contact information and inquiry form for TraceSeis.
 * Designed to facilitate both quick inquiries and detailed project discussions.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact TraceSeis - Get in Touch"
  description="Contact TraceSeis to discuss your reservoir characterization needs. Reach our team in Houston for services, software, or partnership inquiries."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <h1 class="heading-xl mb-6">
          Let's
          <span class="text-gradient"> Connect</span>
        </h1>
        <p class="text-xl text-navy-300 leading-relaxed">
          Ready to discuss how quantitative reservoir characterization can improve your exploration and development decisions? We're here to help.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Information -->
        <div>
          <h2 class="heading-lg mb-8">Get in Touch</h2>
          
          <div class="space-y-6 mb-12">
            <!-- Alvaro Chaveste -->
            <div class="card p-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Alvaro Chaveste</h3>
                  <p class="text-accent-400 text-sm mb-3">Founder & CEO</p>
                  <div class="space-y-2">
                    <a href="tel:+18327076505" class="flex items-center gap-2 text-navy-300 hover:text-white transition-colors text-sm">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                      +1 (832) 707-6505
                    </a>
                    <a href="mailto:achaveste@traceseis.com" class="flex items-center gap-2 text-navy-300 hover:text-white transition-colors text-sm">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                      </svg>
                      achaveste@traceseis.com
                    </a>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Alvaro Chaveste II -->
            <div class="card p-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-1">Alvaro Chaveste II</h3>
                  <p class="text-accent-400 text-sm mb-3">Business Development Lead</p>
                  <div class="space-y-2">
                    <a href="tel:+13462985918" class="flex items-center gap-2 text-navy-300 hover:text-white transition-colors text-sm">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                      +1 (346) 298-5918
                    </a>
                    <a href="mailto:alvarochf@traceseis.com" class="flex items-center gap-2 text-navy-300 hover:text-white transition-colors text-sm">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                      </svg>
                      alvarochf@traceseis.com
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Office Location -->
          <div class="card p-6 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Office Location</h3>
                <p class="text-navy-400 text-sm">Houston, Texas, USA</p>
                <p class="text-navy-500 text-xs mt-2">Serving clients worldwide</p>
              </div>
            </div>
          </div>
          
          <!-- LinkedIn -->
          <div class="flex items-center gap-4">
            <span class="text-navy-400 text-sm">Connect with us:</span>
            <a 
              href="https://www.linkedin.com/company/traceseis-inc" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-navy-300 hover:text-accent-400 transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div>
          <div class="card p-8">
            <h3 class="heading-sm mb-6">Send Us a Message</h3>
            <form 
              action="https://formspree.io/f/your-form-id" 
              method="POST"
              class="space-y-6"
            >
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-navy-300 mb-2">Name *</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required
                    class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white placeholder-navy-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-navy-300 mb-2">Company</label>
                  <input 
                    type="text" 
                    id="company" 
                    name="company"
                    class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white placeholder-navy-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                    placeholder="Your company"
                  />
                </div>
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-navy-300 mb-2">Email *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white placeholder-navy-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                  placeholder="your.email@company.com"
                />
              </div>
              
              <div>
                <label for="phone" class="block text-sm font-medium text-navy-300 mb-2">Phone</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white placeholder-navy-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                  placeholder="+1 (555) 000-0000"
                />
              </div>
              
              <div>
                <label for="interest" class="block text-sm font-medium text-navy-300 mb-2">Area of Interest</label>
                <select 
                  id="interest" 
                  name="interest"
                  class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors"
                >
                  <option value="">Select an option</option>
                  <option value="services">Consulting Services</option>
                  <option value="confirm">CONFIRM Methodology</option>
                  <option value="software">Software (SeisTool)</option>
                  <option value="partnership">Partnership Inquiry</option>
                  <option value="other">Other</option>
                </select>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-navy-300 mb-2">Message *</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  required
                  class="w-full px-4 py-3 rounded-lg bg-navy-900/50 border border-navy-700/50 text-white placeholder-navy-500 focus:outline-none focus:border-accent-500 focus:ring-1 focus:ring-accent-500 transition-colors resize-none"
                  placeholder="Tell us about your project or inquiry..."
                ></textarea>
              </div>
              
              <button 
                type="submit" 
                class="btn-primary w-full text-base py-4"
              >
                Send Message
                <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
              </button>
              
              <p class="text-navy-500 text-xs text-center">
                By submitting this form, you agree to be contacted by TraceSeis regarding your inquiry.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="text-center mb-12">
        <h2 class="heading-md mb-4">Explore TraceSeis</h2>
        <p class="body-md">
          Learn more about our services and solutions while you're here.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href="/services" class="card card-hover p-6 text-center group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">Our Services</h3>
          <p class="text-navy-400 text-sm">Explore our quantitative interpretation and consulting services.</p>
        </a>
        
        <a href="/confirm" class="card card-hover p-6 text-center group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">CONFIRM</h3>
          <p class="text-navy-400 text-sm">Learn about our confidence-driven reservoir characterization methodology.</p>
        </a>
        
        <a href="/software" class="card card-hover p-6 text-center group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">Software</h3>
          <p class="text-navy-400 text-sm">Download SeisTool and explore our rock physics software.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
