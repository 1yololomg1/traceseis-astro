---
/**
 * Homepage - index.astro
 * 
 * Executive-focused landing page designed to:
 * - Establish immediate credibility with technical decision makers
 * - Communicate value propositions clearly and concisely
 * - Drive conversions through strategic CTAs
 * - Showcase expertise through quantifiable results
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="TraceSeis - Quantitative Reservoir Characterization | Geoscience Solutions"
  description="TraceSeis delivers quantitative reservoir characterization through advanced seismic analysis, rock physics modeling, and proprietary inversion technologies. 20+ years of proven results."
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <!-- Background gradient and pattern -->
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    <!-- Accent glow -->
    <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-primary-500/10 rounded-full blur-[100px]"></div>
    
    <div class="container-wide relative z-10 py-20 lg:py-32">
      <div class="max-w-4xl">
        <!-- Trust badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm text-navy-300 mb-8">
          <span class="w-2 h-2 rounded-full bg-success-500 animate-pulse"></span>
          Trusted by exploration teams worldwide since 2003
        </div>
        
        <!-- Main headline -->
        <h1 class="heading-xl text-balance mb-6">
          Quantitative Reservoir Characterization
          <span class="text-gradient"> Backed by Science</span>
        </h1>
        
        <!-- Subheadline -->
        <p class="text-xl lg:text-2xl text-navy-300 leading-relaxed max-w-3xl mb-10">
          Transform seismic data into actionable reservoir insights through rigorous rock physics modeling and advanced inversion techniques. Reduce exploration risk with scientifically validated predictions.
        </p>
        
        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4 mb-16">
          <a href="/services" class="btn-primary text-base px-8 py-4">
            Explore Our Services
            <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="/confirm" class="btn-secondary text-base px-8 py-4">
            Discover CONFIRM
          </a>
        </div>
        
        <!-- Key metrics - scientifically defensible statements -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
          <div class="text-center md:text-left">
            <div class="stat-value text-gradient">20+</div>
            <div class="stat-label">Years of Expertise</div>
          </div>
          <div class="text-center md:text-left">
            <div class="stat-value">Houston</div>
            <div class="stat-label">Based Since 2003</div>
          </div>
          <div class="text-center md:text-left">
            <div class="stat-value text-gradient">QI</div>
            <div class="stat-label">Quantitative Interpretation</div>
          </div>
          <div class="text-center md:text-left">
            <div class="stat-value">Global</div>
            <div class="stat-label">Project Experience</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-navy-500">
      <span class="text-xs uppercase tracking-wider">Scroll to explore</span>
      <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </section>

  <!-- Value Proposition Section -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="heading-lg mb-6">Scientifically Rigorous Reservoir Analysis</h2>
        <p class="body-lg">
          Our methodologies are grounded in established rock physics principles and validated through peer-reviewed research. Every recommendation we make can be traced back to fundamental geoscience.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1: Rock Physics Foundation -->
        <div class="card card-hover group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3">Rock Physics Modeling</h3>
          <p class="body-md mb-4">
            Utilize established theoretical models (Gassmann, Biot-Gassmann, Hertz-Mindlin) to characterize relationships between rock properties, pore fluids, and seismic response.
          </p>
          <a href="/services#rock-physics" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
        
        <!-- Card 2: Seismic Inversion -->
        <div class="card card-hover group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3">Advanced Seismic Inversion</h3>
          <p class="body-md mb-4">
            Apply deterministic and stochastic inversion algorithms to transform seismic amplitudes into quantitative estimates of acoustic impedance, Vp/Vs ratio, and reservoir properties.
          </p>
          <a href="/services#inversion" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
        
        <!-- Card 3: Lithofacies Prediction -->
        <div class="card card-hover group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3">Lithofacies Classification</h3>
          <p class="body-md mb-4">
            Employ statistical and machine learning approaches calibrated to well data for probabilistic lithofacies prediction, quantifying uncertainty in reservoir characterization.
          </p>
          <a href="/services#lithofacies" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
        
        <!-- Card 4: Feasibility Studies -->
        <div class="card card-hover group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3">Feasibility Studies</h3>
          <p class="body-md mb-4">
            Assess the detectability of reservoir properties using synthetic seismic modeling and sensitivity analysis before committing to full-scale interpretation projects.
          </p>
          <a href="/services#feasibility" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
        
        <!-- Card 5: CONFIRM Technology -->
        <div class="card card-hover group border-accent-500/30">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/30 to-primary-500/30 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-3">
            <h3 class="heading-sm">CONFIRM</h3>
            <span class="px-2 py-0.5 text-xs font-medium bg-accent-500/20 text-accent-400 rounded-full">Featured</span>
          </div>
          <p class="body-md mb-4">
            Our proprietary methodology for Confidence-driven reservoir property estimation, integrating multiple data sources with rigorous uncertainty quantification.
          </p>
          <a href="/confirm" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Explore CONFIRM
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
        
        <!-- Card 6: Software Solutions -->
        <div class="card card-hover group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3">SeisTool Software</h3>
          <p class="body-md mb-4">
            Purpose-built rock physics software for analyzing elastic properties, fluid substitution modeling, and AVO response prediction with intuitive visualization.
          </p>
          <a href="/software" class="inline-flex items-center text-accent-400 hover:text-accent-300 text-sm font-medium transition-colors">
            Learn more
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why TraceSeis Section -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="heading-lg mb-6">Why Technical Leaders Choose TraceSeis</h2>
          <p class="body-lg mb-8">
            We combine deep geoscience expertise with rigorous quantitative methods. Our approach is transparent, reproducible, and grounded in peer-reviewed science.
          </p>
          
          <div class="space-y-4">
            <div class="feature-check">
              <span>Methodologies based on established rock physics theory (Gassmann, Biot, Hertz-Mindlin)</span>
            </div>
            <div class="feature-check">
              <span>Uncertainty quantification integrated into every analysis</span>
            </div>
            <div class="feature-check">
              <span>Results validated against well control and production data</span>
            </div>
            <div class="feature-check">
              <span>Transparent workflows that can be audited and reproduced</span>
            </div>
            <div class="feature-check">
              <span>20+ years of experience across diverse geological settings</span>
            </div>
          </div>
          
          <div class="mt-10">
            <a href="/about" class="btn-primary">
              About Our Team
              <svg class="w-4 h-4 ml-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="relative">
          <!-- Visual representation of scientific process -->
          <div class="card p-8">
            <h3 class="heading-sm mb-6 text-center">Our Scientific Framework</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-10 h-10 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold">1</div>
                <div>
                  <div class="font-medium text-white">Data Integration</div>
                  <div class="text-sm text-navy-400">Well logs, seismic, core data synthesis</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-10 h-10 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold">2</div>
                <div>
                  <div class="font-medium text-white">Rock Physics Modeling</div>
                  <div class="text-sm text-navy-400">Theoretical framework calibration</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-10 h-10 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold">3</div>
                <div>
                  <div class="font-medium text-white">Seismic Inversion</div>
                  <div class="text-sm text-navy-400">Quantitative property estimation</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-10 h-10 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold">4</div>
                <div>
                  <div class="font-medium text-white">Uncertainty Analysis</div>
                  <div class="text-sm text-navy-400">Probabilistic interpretation</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-accent-500/10 border border-accent-500/30">
                <div class="w-10 h-10 rounded-full bg-accent-500/30 flex items-center justify-center text-accent-400 font-bold">5</div>
                <div>
                  <div class="font-medium text-white">Validated Results</div>
                  <div class="text-sm text-navy-400">Decision-ready deliverables</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONFIRM Highlight Section -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-primary-950/50 to-navy-950"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent-500/5 rounded-full blur-[100px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-500/10 border border-accent-500/30 text-sm text-accent-400 mb-8">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Proprietary Technology
        </div>
        
        <h2 class="heading-lg mb-6">
          Introducing <span class="text-gradient">CONFIRM</span>
        </h2>
        <p class="text-xl text-navy-300 leading-relaxed mb-8">
          <strong class="text-white">CO</strong>nfidence-driven <strong class="text-white">N</strong>et reservoir <strong class="text-white">F</strong>ormation <strong class="text-white">I</strong>nversion for <strong class="text-white">R</strong>eservoir <strong class="text-white">M</strong>apping
        </p>
        <p class="body-lg mb-10">
          CONFIRM represents our integrated approach to reservoir characterization that combines rock physics, seismic inversion, and statistical analysis to deliver property estimates with quantified confidence intervals. Make better drilling decisions with data you can trust.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/confirm" class="btn-primary text-base px-8 py-4">
            Learn About CONFIRM
            <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="/contact" class="btn-secondary text-base px-8 py-4">
            Request a Consultation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partners & Credibility -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="text-center mb-12">
        <h2 class="heading-md mb-4">Strategic Partnerships</h2>
        <p class="body-lg max-w-2xl mx-auto">
          We collaborate with industry leaders to deliver comprehensive geoscience solutions.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="https://www.geoinsights.com/" target="_blank" rel="noopener" class="card card-hover text-center p-8 group">
          <div class="text-lg font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">Geophysical Insights</div>
          <p class="text-sm text-navy-400">Machine learning for subsurface interpretation</p>
        </a>
        <a href="https://z-terra.com/" target="_blank" rel="noopener" class="card card-hover text-center p-8 group">
          <div class="text-lg font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">Z-Terra</div>
          <p class="text-sm text-navy-400">Seismic imaging and processing</p>
        </a>
        <a href="https://www.nmrpetrophysics.com/" target="_blank" rel="noopener" class="card card-hover text-center p-8 group">
          <div class="text-lg font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">NMR Petrophysics</div>
          <p class="text-sm text-navy-400">Advanced petrophysical analysis</p>
        </a>
        <a href="https://www.brtenergy.com/" target="_blank" rel="noopener" class="card card-hover text-center p-8 group">
          <div class="text-lg font-semibold text-white mb-2 group-hover:text-accent-400 transition-colors">BRT Energy Advisors</div>
          <p class="text-sm text-navy-400">Prospect generation and evaluation</p>
        </a>
      </div>
      
      <div class="text-center mt-10">
        <a href="/partners" class="inline-flex items-center text-accent-400 hover:text-accent-300 font-medium transition-colors">
          View all partners
          <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-950 via-navy-950 to-primary-950"></div>
    <div class="absolute inset-0 opacity-30">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-lg mb-6">Ready to Reduce Exploration Risk?</h2>
        <p class="body-lg mb-10">
          Connect with our team to discuss how quantitative reservoir characterization can improve your exploration and development decisions.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary text-base px-8 py-4">
