---
/**
 * Partners Page - partners.astro
 * 
 * Showcases TraceSeis strategic partnerships with industry leaders.
 * Builds credibility by association with recognized companies.
 */

import BaseLayout from '../layouts/BaseLayout.astro';

// Partner data
const partners = [
  {
    name: 'Geophysical Insights',
    url: 'https://www.geoinsights.com/',
    description: 'Machine learning and analytics applications for subsurface interpretation. Geophysical Insights develops Paradise, an advanced AI-powered platform for seismic interpretation.',
    expertise: ['Machine Learning', 'Seismic Classification', 'Multi-attribute Analysis']
  },
  {
    name: 'Z-Terra',
    url: 'https://z-terra.com/',
    description: 'Integrated seismic imaging software and processing services. Z-Terra provides advanced depth imaging solutions including RTM and FWI technologies.',
    expertise: ['Depth Imaging', 'Velocity Modeling', 'RTM/FWI']
  },
  {
    name: 'NMR Petrophysics',
    url: 'https://www.nmrpetrophysics.com/',
    description: 'Specialized petrophysical and mineralogical evaluations. NMR Petrophysics provides expert analysis of nuclear magnetic resonance logs and core data.',
    expertise: ['NMR Analysis', 'Petrophysics', 'Core-Log Integration']
  },
  {
    name: 'BRT Energy Advisors',
    url: 'https://www.brtenergy.com/',
    description: 'Prospect generation, evaluations, and technical advisory services. BRT Energy provides independent technical and commercial assessments.',
    expertise: ['Prospect Generation', 'Technical Due Diligence', 'Resource Evaluation']
  }
];
---

<BaseLayout 
  title="Partners - Strategic Alliances | TraceSeis"
  description="TraceSeis partners with industry leaders in machine learning, seismic imaging, petrophysics, and energy advisory to deliver comprehensive geoscience solutions."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <h1 class="heading-xl mb-6">
          Strategic
          <span class="text-gradient"> Partners</span>
        </h1>
        <p class="text-xl text-navy-300 leading-relaxed">
          We collaborate with select industry leaders to provide comprehensive solutions that address the full spectrum of subsurface characterization challenges.
        </p>
      </div>
    </div>
  </section>

  <!-- Partnership Philosophy -->
  <section class="section section-gradient">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="heading-lg mb-6">Complementary Expertise</h2>
        <p class="body-lg">
          Our partnerships are built on the principle that the best solutions come from combining specialized expertise. Each partner brings capabilities that enhance our quantitative interpretation services.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        {partners.map((partner) => (
          <a 
            href={partner.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="card card-hover p-8 group"
          >
            <div class="flex items-start justify-between mb-4">
              <h3 class="heading-sm group-hover:text-accent-400 transition-colors">{partner.name}</h3>
              <svg class="w-5 h-5 text-navy-500 group-hover:text-accent-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </div>
            <p class="text-navy-400 text-sm mb-6">{partner.description}</p>
            <div class="flex flex-wrap gap-2">
              {partner.expertise.map((skill) => (
                <span class="px-3 py-1 text-xs font-medium bg-navy-700/50 text-navy-300 rounded-full">{skill}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Work Together -->
  <section class="section section-dark">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="heading-lg mb-6">How We Collaborate</h2>
          <p class="body-lg mb-6">
            Our partnerships are designed to provide seamless solutions. When a project requires capabilities beyond our core expertise, we bring in the right partner to ensure you get the best possible result.
          </p>
          
          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Integrated Workflows</h4>
                <p class="text-navy-400 text-sm">Joint project teams ensure smooth handoffs and consistent quality.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Single Point of Contact</h4>
                <p class="text-navy-400 text-sm">TraceSeis manages the partnership, simplifying your experience.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Quality Assurance</h4>
                <p class="text-navy-400 text-sm">All deliverables meet TraceSeis standards for scientific rigor.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card p-8">
          <h3 class="heading-sm mb-6">Combined Capabilities</h3>
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-medium text-white text-sm mb-2">Seismic Imaging + QI</h4>
              <p class="text-navy-400 text-xs">Optimized processing for quantitative interpretation applications.</p>
            </div>
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-medium text-white text-sm mb-2">ML Classification + Rock Physics</h4>
              <p class="text-navy-400 text-xs">Machine learning guided by physical constraints for robust facies prediction.</p>
            </div>
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-medium text-white text-sm mb-2">Petrophysics + Seismic Inversion</h4>
              <p class="text-navy-400 text-xs">Integrated well and seismic analysis for consistent property models.</p>
            </div>
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-medium text-white text-sm mb-2">Technical Evaluation + Uncertainty</h4>
              <p class="text-navy-400 text-xs">Risk-calibrated prospect assessment with quantified confidence.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-950 via-navy-950 to-primary-950"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-lg mb-6">Looking for a Comprehensive Solution?</h2>
        <p class="body-lg mb-10">
          Contact us to discuss how our partnership network can address your specific project requirements.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary text-base px-8 py-4">
            Discuss Your Project
            <svg class="w-5 h-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a href="/services" class="btn-secondary text-base px-8 py-4">
            View Our Services
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
