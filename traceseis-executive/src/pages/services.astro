---
/**
 * Services Page - services.astro
 * 
 * Comprehensive overview of TraceSeis service offerings:
 * - Seismic Data Processing
 * - Feasibility Studies
 * - Lithofacies Prediction
 * - Reservoir Property Inversion
 * - Rock Physics Analysis
 * 
 * Each service is presented with scientific basis and practical applications.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Services - Quantitative Reservoir Characterization | TraceSeis"
  description="TraceSeis provides seismic data processing, feasibility studies, lithofacies prediction, and reservoir property inversion services grounded in rock physics principles."
>
  <!-- Hero Section -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-primary-950"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-accent-500/10 rounded-full blur-[120px]"></div>
    
    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm text-navy-300 mb-6">
          Science-Backed Solutions
        </div>
        <h1 class="heading-xl mb-6">
          Geoscience Services Built on
          <span class="text-gradient"> Rigorous Science</span>
        </h1>
        <p class="text-xl text-navy-300 leading-relaxed">
          Our services integrate established rock physics theory, advanced computational methods, and decades of practical experience to deliver quantitative reservoir characterization with confidence.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section section-gradient" id="overview">
    <div class="container-wide">
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Service Navigation Cards -->
        <a href="#seismic-processing" class="card card-hover group p-8">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3 group-hover:text-accent-400 transition-colors">Seismic Data Processing</h3>
          <p class="body-md">Specialized processing workflows optimized for quantitative interpretation and inversion applications.</p>
        </a>
        
        <a href="#feasibility" class="card card-hover group p-8">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3 group-hover:text-accent-400 transition-colors">Feasibility Studies</h3>
          <p class="body-md">Quantitative assessment of seismic detectability before committing to interpretation projects.</p>
        </a>
        
        <a href="#lithofacies" class="card card-hover group p-8">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3 group-hover:text-accent-400 transition-colors">Lithofacies Prediction</h3>
          <p class="body-md">Statistical classification of rock types using seismic attributes calibrated to well data.</p>
        </a>
        
        <a href="#inversion" class="card card-hover group p-8">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3 group-hover:text-accent-400 transition-colors">Reservoir Property Inversion</h3>
          <p class="body-md">Transform seismic data into quantitative estimates of porosity, lithology, and fluid content.</p>
        </a>
        
        <a href="#rock-physics" class="card card-hover group p-8">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/20 to-primary-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
            </svg>
          </div>
          <h3 class="heading-sm mb-3 group-hover:text-accent-400 transition-colors">Rock Physics Analysis</h3>
          <p class="body-md">Theoretical modeling of seismic response to rock and fluid properties using established physics.</p>
        </a>
        
        <a href="/confirm" class="card card-hover group p-8 border-accent-500/30">
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-accent-500/30 to-primary-500/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-3">
            <h3 class="heading-sm group-hover:text-accent-400 transition-colors">CONFIRM</h3>
            <span class="px-2 py-0.5 text-xs font-medium bg-accent-500/20 text-accent-400 rounded-full">Featured</span>
          </div>
          <p class="body-md">Our integrated methodology combining all services with rigorous uncertainty quantification.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Seismic Data Processing -->
  <section class="section section-dark" id="seismic-processing">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/10 text-xs font-medium text-accent-400 uppercase tracking-wider mb-4">
            Service
          </div>
          <h2 class="heading-lg mb-6">Seismic Data Processing</h2>
          <p class="body-lg mb-6">
            Our processing workflows are specifically designed to preserve amplitude fidelity and phase characteristics essential for quantitative interpretation. Unlike conventional processing, we prioritize the attributes that matter for reservoir characterization.
          </p>
          
          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Amplitude-Preserving Processing</h4>
                <p class="text-navy-400 text-sm">Careful treatment of gains, filters, and corrections to maintain relative amplitude relationships critical for AVO analysis.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Pre-Stack Processing</h4>
                <p class="text-navy-400 text-sm">Offset-dependent processing and angle gathers optimized for simultaneous inversion applications.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Wavelet Estimation</h4>
                <p class="text-navy-400 text-sm">Statistical and deterministic wavelet extraction for accurate tie to well data and inversion conditioning.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card p-8">
          <h3 class="heading-sm mb-4">Technical Foundation</h3>
          <p class="body-md mb-6">
            Our processing approach is grounded in the physics of wave propagation. We apply corrections based on established theory:
          </p>
          <ul class="space-y-3 text-navy-300">
            <li class="flex items-start gap-3">
              <span class="text-accent-400 mt-1">-</span>
              <span><strong class="text-white">Geometric spreading:</strong> Compensated using known velocity models and spherical divergence corrections</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-400 mt-1">-</span>
              <span><strong class="text-white">Attenuation (Q):</strong> Inverse-Q filtering based on measured or estimated quality factors</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-400 mt-1">-</span>
              <span><strong class="text-white">NMO stretch:</strong> Careful mute design to avoid frequency distortion at far offsets</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-400 mt-1">-</span>
              <span><strong class="text-white">Migration aperture:</strong> Optimized for target depth and structural complexity</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Feasibility Studies -->
  <section class="section section-gradient" id="feasibility">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1">
          <div class="card p-8">
            <h3 class="heading-sm mb-4">Feasibility Workflow</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-8 h-8 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold text-sm">1</div>
                <div>
                  <div class="font-medium text-white text-sm">Well Log Analysis</div>
                  <div class="text-xs text-navy-400">Extract elastic properties and define scenarios</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-8 h-8 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold text-sm">2</div>
                <div>
                  <div class="font-medium text-white text-sm">Rock Physics Modeling</div>
                  <div class="text-xs text-navy-400">Fluid substitution and property variations</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-8 h-8 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold text-sm">3</div>
                <div>
                  <div class="font-medium text-white text-sm">Synthetic Seismic Generation</div>
                  <div class="text-xs text-navy-400">Convolution with representative wavelets</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-navy-900/50">
                <div class="w-8 h-8 rounded-full bg-accent-500/20 flex items-center justify-center text-accent-400 font-bold text-sm">4</div>
                <div>
                  <div class="font-medium text-white text-sm">Sensitivity Analysis</div>
                  <div class="text-xs text-navy-400">Quantify detectability and discrimination</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 rounded-xl bg-accent-500/10 border border-accent-500/20">
                <div class="w-8 h-8 rounded-full bg-accent-500/30 flex items-center justify-center text-accent-400 font-bold text-sm">5</div>
                <div>
                  <div class="font-medium text-white text-sm">Go/No-Go Recommendation</div>
                  <div class="text-xs text-navy-400">Data-driven decision support</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/10 text-xs font-medium text-accent-400 uppercase tracking-wider mb-4">
            Service
          </div>
          <h2 class="heading-lg mb-6">Feasibility Studies</h2>
          <p class="body-lg mb-6">
            Before committing resources to a full interpretation project, understand whether seismic data can actually resolve your targets. Our feasibility studies use forward modeling to quantify what is detectable given your specific geological and seismic conditions.
          </p>
          <p class="body-md mb-6">
            This approach is scientifically rigorous because it works forward from known physics: we start with measured rock properties, apply established rock physics models, and compute the expected seismic response. The result is an objective assessment of detectability.
          </p>
          
          <div class="bg-navy-800/50 rounded-xl p-6 border border-navy-700/50">
            <h4 class="font-semibold text-white mb-3">Key Questions Answered:</h4>
            <ul class="space-y-2 text-navy-300 text-sm">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Can porosity variations be distinguished from lithology changes?</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>Is the hydrocarbon effect separable from brine response?</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-accent-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>What is the minimum detectable thickness or property contrast?</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lithofacies Prediction -->
  <section class="section section-dark" id="lithofacies">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/10 text-xs font-medium text-accent-400 uppercase tracking-wider mb-4">
            Service
          </div>
          <h2 class="heading-lg mb-6">Lithofacies Prediction</h2>
          <p class="body-lg mb-6">
            Transform seismic attributes into geological rock types using statistical classification methods calibrated to well data. Our approach provides not just a single answer, but probability distributions that quantify prediction uncertainty.
          </p>
          
          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Bayesian Classification</h4>
                <p class="text-navy-400 text-sm">Statistical framework that incorporates prior geological knowledge with seismic observations to compute posterior probabilities for each facies.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Neural Network Methods</h4>
                <p class="text-navy-400 text-sm">Supervised learning algorithms trained on well control to recognize complex, non-linear relationships between seismic and facies.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-accent-500/20 flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Cross-Validation</h4>
                <p class="text-navy-400 text-sm">Blind well testing to objectively assess prediction accuracy before applying models to undrilled areas.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="card p-8">
          <h3 class="heading-sm mb-4">Scientific Basis</h3>
          <p class="body-md mb-6">
            Lithofacies prediction is grounded in the physical relationship between rock composition and seismic response:
          </p>
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-semibold text-white text-sm mb-2">Elastic Property Separation</h4>
              <p class="text-navy-400 text-xs">Different minerals (quartz, feldspar, clay, calcite) have distinct elastic moduli and densities that manifest as separable clusters in impedance space.</p>
            </div>
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-semibold text-white text-sm mb-2">Vp/Vs Discrimination</h4>
              <p class="text-navy-400 text-xs">Shale typically exhibits higher Vp/Vs than sand at similar porosity, enabling lithology discrimination through simultaneous inversion.</p>
            </div>
            <div class="p-4 rounded-xl bg-navy-900/50">
              <h4 class="font-semibold text-white text-sm mb-2">Probabilistic Framework</h4>
              <p class="text-navy-400 text-xs">Results are expressed as probabilities, acknowledging that seismic data cannot uniquely determine lithology - uncertainty quantification is built in.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reservoir Property Inversion -->
  <section class="section section-gradient" id="inversion">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-500/10 text-xs font-medium text-accent-400 uppercase tracking-wider mb-4">
          Service
        </div>
        <h2 class="heading-lg mb-6">Inversion to Reservoir Properties</h2>
        <p class="body-lg">
          The ultimate goal of quantitative interpretation: transform seismic data into estimates of the reservoir properties that drive economic decisions - porosity, net pay, fluid saturation.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Acoustic Impedance Inversion</h3>
          <p class="text-navy-400 text-sm mb-4">
            Post-stack inversion to estimate P-impedance (Vp x density), the fundamental elastic property most directly related to seismic amplitude.
          </p>
          <div class="text-xs text-navy-500">
            Based on convolutional model: Seismic = Wavelet * Reflectivity
          </div>
        </div>
        
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Simultaneous AVO Inversion</h3>
          <p class="text-navy-400 text-sm mb-4">
            Pre-stack inversion exploiting angle-dependent reflectivity (Aki-Richards approximation) to independently estimate P-impedance, S-impedance, and density.
          </p>
          <div class="text-xs text-navy-500">
            Zoeppritz equations linearized for practical application
          </div>
        </div>
        
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Extended Elastic Impedance</h3>
          <p class="text-navy-400 text-sm mb-4">
            Generalized impedance formulation (Whitcombe et al.) optimized for specific rock property discrimination at any projection angle.
          </p>
          <div class="text-xs text-navy-500">
            Angle rotation to maximize target sensitivity
          </div>
        </div>
        
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Rock Physics Transforms</h3>
          <p class="text-navy-400 text-sm mb-4">
            Convert elastic properties to reservoir properties (porosity, Vclay, Sw) using calibrated rock physics relationships derived from well data.
          </p>
          <div class="text-xs text-navy-500">
            Empirical calibration with theoretical constraints
          </div>
        </div>
        
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Stochastic Inversion</h3>
          <p class="text-navy-400 text-sm mb-4">
            Generate multiple equally-probable realizations that honor both seismic and well data, capturing geological variability below seismic resolution.
          </p>
          <div class="text-xs text-navy-500">
            Geostatistical simulation with seismic constraint
          </div>
        </div>
        
        <div class="card p-6">
          <h3 class="font-semibold text-white mb-3">Uncertainty Quantification</h3>
          <p class="text-navy-400 text-sm mb-4">
            Propagate seismic noise, wavelet uncertainty, and rock physics scatter through inversion to deliver confidence intervals on property estimates.
          </p>
          <div class="text-xs text-navy-500">
            Monte Carlo and analytical error propagation
          </div>
        </div>
      </div>
